# ── Open Markets environment configuration ──────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All VITE_* vars are embedded into the client bundle and are therefore PUBLIC.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EODHD — https://eodhd.com (Settings → API tokens)
# For LOCAL testing only. In production the EODHD key should live server-side
# in a Supabase Edge Function, NOT here (see the data-layer phase).
VITE_EODHD_API_KEY=
